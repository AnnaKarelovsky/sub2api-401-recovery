# Application
APP_HOST=0.0.0.0
APP_PORT=1455
DATABASE_PATH=/data/recovery.db
BACKUP_DIR=/backups
LOG_LEVEL=INFO

# Generate both secrets during installation. Never commit the real values.
ENCRYPTION_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
DASHBOARD_SECRET=
DASHBOARD_SESSION_MINUTES=720

# Sub2API Admin API. The API key is preferred over a user JWT.
SUB2API_BASE_URL=
SUB2API_ADMIN_KEY=
SUB2API_JWT=
SUB2API_TIMEOUT_SECONDS=30
SUB2API_TEST_TIMEOUT_SECONDS=90

# Scheduler
SCAN_INTERVAL_SECONDS=60
SCAN_PAGE_SIZE=100
SCAN_PROBE_ACTIVE_ACCOUNTS=true
SCAN_PROBE_INTERVAL_SECONDS=900
MATERIAL_SYNC_ENABLED=true
MATERIAL_SYNC_HOUR=0
MATERIAL_SYNC_TIMEZONE=Asia/Shanghai
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_BACKOFF_SECONDS=30
WORKER_POLL_SECONDS=3
WORKER_STALE_SECONDS=900

# OpenAI Codex-compatible OAuth
OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OPENAI_OAUTH_SCOPE=openid profile email offline_access api.connectors.read api.connectors.invoke
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_TIMEOUT_SECONDS=120
OPENAI_ORIGINATOR=codex_cli_rs

# Real browser flow. The browser never bypasses CAPTCHA, email verification, or MFA.
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_SECONDS=600
PLAYWRIGHT_PROXY=

# Automatic note-driven OAuth recovery.
AUTOMATION_REQUIRE_COMPLETE_NOTES=true
AUTOMATION_BROWSER_RETRIES=2
AUTOMATION_CHALLENGE_TIMEOUT_SECONDS=90
AUTOMATION_RETRY_FOREVER=true
AUTOMATION_RETRY_BACKOFF_SECONDS=900
# Optional: connect to a user-managed real Chromium CDP endpoint instead of launching Playwright Chromium.
AUTOMATION_CDP_URL=
AUTOMATION_CHROMIUM_PATH=
MAIL_IMAP_HOST=outlook.office365.com
MAIL_IMAP_PORT=993
MAIL_IMAP_FOLDER=INBOX
MAIL_CODE_TIMEOUT_SECONDS=150
MAIL_POLL_SECONDS=5
OUTLOOK_WEBMAIL_ENABLED=true

# NAS egress proxy. httpx honors these values; Playwright uses PLAYWRIGHT_PROXY when set.
# In Docker, use a host-reachable proxy address such as host.docker.internal:7890.
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890
ALL_PROXY=http://host.docker.internal:7890
NO_PROXY=localhost,127.0.0.1,sub2api,host.docker.internal
